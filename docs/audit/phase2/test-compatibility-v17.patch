+"""Real capacity-aware fixtures for legacy Planner transport/lifecycle tests.
+
+These are explicit Mock model/operator contracts; no production gate is patched.
+"""
+
+from forge_core.domain import ModelProfile, ProtocolSupport
+
+
+def configure_planner_capacity(main):
+    main.store.save_model(ModelProfile(
+        id="planner-capacity-fixture", provider="planner-fixture", model_id="mock",
+        display_name="Explicit Mock Planner fixture", context_window=65536,
+        max_output_tokens=4096,
+        tool_calling_support=ProtocolSupport(supported=True, source="test_fixture"),
+        structured_output_support=ProtocolSupport(supported=True, source="test_fixture"),
+    ))
+    main.router.provider_id = "planner-fixture"
+    main.router.context_limit = 65536
+
+
+def capacity_graph(key, objective):
+    return {
+        "nodes": [{"key": key, "objective": objective, "success_criteria": ["delivery_review"],
+                   "budget_tokens": 150000, "required_capabilities": [], "allowed_tools": [],
+                   "expected_artifact": None, "max_attempts": 1, "required_input_paths": [],
+                   "capacity_bounds": {"max_source_receipt_bytes": 2048,
+                                       "max_artifact_bytes": 3072, "max_delivery_bytes": 1536}}],
+        "edges": [], "max_total_tokens": 180000, "coordination_reserve_tokens": 18000,
+        "max_cost_microunits": None, "max_duration_seconds": None, "cost_currency": None,
+    }
