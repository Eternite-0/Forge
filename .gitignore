# Local environment variables; keep examples available for the team.
.env
.env.*
!.env.example
!.env.*.example

# Operating system files.
.DS_Store
Thumbs.db
Desktop.ini

# Local editor preferences; allow shared VS Code configuration.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Logs and temporary files.
*.log
!docs/audit/**/*.log
*.tmp
*.swp
*~

# Frontend, Python, Rust, and local verification artifacts.
node_modules/
dist/
build/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
target/
.local/
desktop/.playwright-cli/
desktop/src-tauri/gen/schemas/

# Desktop validation evidence is versioned; copied runtimes/workspaces stay local.
desktop/output/native-*/
desktop/output/reference-dsh/
desktop/output/.forge-*
desktop/output/*-polish.css
desktop/output/task-navigation.css
desktop/output/native-final-process.txt

# Imported FORGE release runtime data and Python packaging artifacts.
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.egg-info/
