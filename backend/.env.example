# Copy this file to <WorkspaceRoot>/.env, not the current shell directory.
# Select WorkspaceRoot first with --workspace-root or the FORGE_WORKSPACE_ROOT process variable.
# Relative paths below are resolved from WorkspaceRoot. Process variables override this file.
# Never put FORGE_CORE_SECRET in this file; pass it only through a trusted process environment.
# FORGE_WORKSPACE_ID=your-stable-workspace-id
FORGE_DB_PATH=data/forge.sqlite3
FORGE_HOST=127.0.0.1
FORGE_PORT=8765
